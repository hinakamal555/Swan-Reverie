# MongoDB Atlas connection string. Never expose this to the browser.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/wedding-invitations?retryWrites=true&w=majority
MONGODB_DB=wedding-invitations

# Clerk authentication (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Public site origin used in copy-link fallbacks
PUBLIC_ORIGIN=http://localhost:8888

# Local server
PORT=8888

# Optional Cloudinary for production media uploads:
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
